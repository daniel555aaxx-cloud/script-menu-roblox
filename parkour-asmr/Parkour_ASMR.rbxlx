	{ x = 1100.2, y = 62, z = 2.9, title = "MUNDO 4 — Caverna de Jade", subtitle = "Níveis 19–24" },
	{ x = 1479, y = 69.7, z = -2.1, title = "MUNDO 5 — Fábrica de Ferro", subtitle = "Níveis 25–30" },
