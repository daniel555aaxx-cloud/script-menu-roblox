local function showChoices(choices)
	clearChoices()
	for index, choice in ipairs(choices or {}) do
		local button = makeButton(
			choicesFrame,
			"Choice_" .. tostring(index),
			choice.label or "Responder",
			UDim2.new(0, 0, 0, 0),
