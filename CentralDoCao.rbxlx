		for _, segment in ipairs({{-44, 12}, {-16, 12}, {10.5, 9}, {40.5, 19}}) do
			box(parent, "SideWall", Vector3.new(2, 20, segment[2]), Vector3.new(x, 10, segment[1]), C.Wall, Enum.Material.Concrete)
		end
