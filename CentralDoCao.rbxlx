	box(parent, "FrontWindowPillarRight", Vector3.new(1, 20, 2), Vector3.new(12.5, 10, 50), C.Wall, Enum.Material.Concrete)
	addDecorativeWindow(parent, "Front", Vector3.new(-26, 10, 49.2), 26, 9)
	addDecorativeWindow(parent, "Front", Vector3.new(26, 10, 49.2), 26, 9)
