function Cast.getNpc(id)
	for _, npc in ipairs(Cast.Npcs) do
		if npc.id == id then
			return npc
		end
	end
	return nil
end

function Cast.getNpcsForEpisode(episodeId)
	local list = {}
	for _, npc in ipairs(Cast.Npcs) do
		if npc.episode == episodeId then
			table.insert(list, npc)
		end
	end
	return list
end

