-- O vilão do arco final entra no mesmo registro para que qualquer episódio
-- (inclusive o FINAL) possa ser consultado de forma uniforme.
Cast.Monsters.FINAL = Cast.FinaleVillain

function Cast.getMonster(episodeId)
	return Cast.Monsters[episodeId]
end

